{
  // Bahar — Cloudflare Workers deployment (via OpenNext).
  // SESSION_SECRET and CRON_SECRET are set as Worker secrets, never here:
  //   wrangler secret put SESSION_SECRET
  //   wrangler secret put CRON_SECRET
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bahar",
  "main": "worker.ts",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  // Observability — mirrors the dashboard Logs setting enabled 2026-10-28
  // (invocation logs + persist, 100% sampling; traces/issues left off),
  // so a future deploy does not revert it. Field shape verified against
  // the installed wrangler 4.152.0 config schema (definitions.Observability).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": false
    },
    "issues": {
      "enabled": false
    }
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bahar-db",
      "database_id": "e62e92c2-b7d3-4dce-98f0-257fe176aa7a"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
