# Bahar environment — copy to ".env" and fill in real values.
# Never commit your real .env file.

# Prisma datasource (SQLite file, relative to the prisma/ folder or absolute)
DATABASE_URL="file:./db/custom.db"

# REQUIRED in production: long random secret used to sign session cookies,
# captcha challenges, OTP and two-factor tokens.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=""

# Development only: set to 1 to let `bun run seed` assign the public demo
# password ("demo1234") to the two demo accounts. Never enable in production.
# SEED_DEMO=""
